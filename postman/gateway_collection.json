{
  "info": {
    "name": "Gateway (barriSense.backend)",
    "_postman_id": "gateway-service_collection_v5.01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get CSRF (via Gateway)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/csrf",
          "host": [
            "{{base_url}}:{{gateway_port}}"
          ],
          "path": [
            "csrf"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const token = response.token;",
              "if (token) {",
              "  pm.environment.set('csrf_token', token);",
              "  console.log('✅ CSRF token stored via Gateway:', token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Register (via Gateway)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrf_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/auth/register",
          "host": [
            "{{base_url}}:{{gateway_port}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Registers a new user through the Gateway. Requires a valid CSRF token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  const body = JSON.parse(pm.request.body.raw);",
              "  if (body.username) {",
              "    pm.environment.set('username', body.username);",
              "    console.log('✅ username set from Register body:', body.username);",
              "  }",
              "} catch(e){console.warn('⚠️ Could not extract username from Register body');}"
            ]
          }
        }
      ]
    },
