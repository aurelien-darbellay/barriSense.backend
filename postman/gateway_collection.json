  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-add X-XSRF-TOKEN for protected endpoints",
          "const url = pm.request.url.toString();",
          "if (url.includes('/protected')) {",
          "  const token = pm.environment.get('csrf_token');",
          "  if (token) {",
          "    pm.request.headers.remove('X-XSRF-TOKEN');",
          "    pm.request.headers.add({ key: 'X-XSRF-TOKEN', value: token });",
          "    console.log('✅ Added X-XSRF-TOKEN header for protected request:', token);",
          "  } else {",
          "    console.warn('⚠️ No csrf_token found before protected request');",
          "  }",
          "}"
        ]
      }
    },
    {
