  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Add CSRF token automatically for unsafe HTTP methods",
          "const unsafeMethods = ['POST', 'PUT', 'PATCH', 'DELETE'];",
          "const method = pm.request.method;",
          "const token = pm.environment.get('csrf_token');",
          "",
          "if (unsafeMethods.includes(method)) {",
          "    if (token) {",
          "        pm.request.headers.remove('X-XSRF-TOKEN');",
          "        pm.request.headers.add({ key: 'X-XSRF-TOKEN', value: token });",
          "        console.log(`✅ Added X-XSRF-TOKEN header for ${method} request:`, token);",
          "    } else {",
          "        console.warn(`⚠️ No csrf_token found in environment before ${method} request.`);",
          "    }",
          "} else {",
          "    console.log(`ℹ️ CSRF header not needed for ${method} request.`);",
          "}"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
