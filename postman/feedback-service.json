{
  "info": {
    "name": "Complaint Service(barriSense.backend)",
    "_postman_id": "complaint-service-collection",
    "description": "Postman collection for the ComplaintController of the Feedback microservice (H2 in-memory DB, public and protected endpoints, cookie-based auth).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost"
    },
    {
      "key": "complaint_port",
      "value": "8082"
    },
    {
      "key": "hood_id",
      "value": "1"
    },
    {
      "key": "complaint_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Get All Complaints",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{complaint_port}}/api/complaints",
          "host": [
            "{{base_url}}:{{complaint_port}}"
          ],
          "path": [
            "api",
            "complaints"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Complaint By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{complaint_port}}/api/complaints/{{complaint_id}}",
          "host": [
            "{{base_url}}:{{complaint_port}}"
          ],
          "path": [
            "api",
            "complaints",
            "{{complaint_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Complaint Count by Neighborhood (single)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{complaint_port}}/api/complaints/count/by-neighborhood/{{hood_id}}",
          "host": [
            "{{base_url}}:{{complaint_port}}"
          ],
          "path": [
            "api",
            "complaints",
            "count",
            "by-neighborhood",
            "{{hood_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Complaints by Neighborhood (list)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{complaint_port}}/api/complaints/by-neighborhood/{{hood_id}}",
          "host": [
            "{{base_url}}:{{complaint_port}}"
          ],
          "path": [
            "api",
            "complaints",
            "by-neighborhood",
            "{{hood_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Complaint Counts for All Neighborhoods",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{complaint_port}}/api/complaints/count/by-neighborhood/all",
          "host": [
            "{{base_url}}:{{complaint_port}}"
          ],
          "path": [
            "api",
            "complaints",
            "count",
            "by-neighborhood",
            "all"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create New Complaint (Cookie Auth)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}:{{complaint_port}}/api/complaints/protected",
          "host": [
            "{{base_url}}:{{complaint_port}}"
          ],
          "path": [
            "api",
            "complaints",
            "protected"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"hoodId\": 3,\n  \"hoodName\": \"Raval\",\n  \"content\": \"Too much noise at night near the plaza.\"\n}"
        },
        "description": "Requires cookie-based authentication. Make sure to log in via the Auth Service before sending this request so that Postman stores the session cookie automatically."
      },
      "response": []
    }
  ]
}
