{
  "info": {
    "name": "Feedback Service",
    "_postman_id": "feedback-service-collection",
    "description": "Postman collection for the Feedback microservice (H2 in-memory DB, public and protected endpoints).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost"
    },
    {
      "key": "feedback_port",
      "value": "8081"
    }
  ],
  "item": [
    {
      "name": "Get All Feedbacks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{feedback_port}}/feedbacks/public",
          "host": [
            "{{base_url}}:{{feedback_port}}"
          ],
          "path": [
            "feedbacks",
            "public"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Add Feedback",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}:{{feedback_port}}/feedbacks/protected/new",
          "host": [
            "{{base_url}}:{{feedback_port}}"
          ],
          "path": [
            "feedbacks",
            "protected",
            "new"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"neighboorhoodId\": 22,\n  \"content\": \"Public spaces are well maintained.\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Get Number of Feedbacks by Neighborhood",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{feedback_port}}/feedbacks/public/feedbacks-by-hood",
          "host": [
            "{{base_url}}:{{feedback_port}}"
          ],
          "path": [
            "feedbacks",
            "public",
            "feedbacks-by-hood"
          ]
        }
      },
      "response": []
    }
  ]
}
